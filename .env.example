# Port the server listens on
PORT=3000

# Secret for the GitHub auto-deploy webhook (POST /webhook). Leave unset to disable.
WEBHOOK_SECRET=

# Login passwords for each role
HOST_PASSWORD=
MEMBER_PASSWORD=
GUEST_PASSWORD=

# Google Cloud Vision API key, used for OCR in Prep Notes (Quote Composer / image text capture)
GOOGLE_VISION_API_KEY=

# ── Public demo deployments ──────────────────────────────────────────
# Set DEMO_MODE to any truthy value to turn on every guardrail below: local-only
# recording (server never persists chunks), disabled Prep Notes file uploads,
# tighter upload caps, a scheduled full data wipe, request rate limiting, and
# restrictive CORS. Leave unset for normal self-hosted use.
DEMO_MODE=

# How often (in minutes) DEMO_MODE wipes all recordings/prep-notes/prep-sources/
# screenshots/clips/branding and resets studio settings to defaults.
DEMO_WIPE_INTERVAL_MINUTES=25

# Max consecutive wipe cycles that may be deferred while a room is active,
# before the wipe is forced anyway. Prevents one abandoned tab from blocking resets.
DEMO_WIPE_MAX_DEFER_CYCLES=3

# Combined size cap (in MB) across the demo data dirs (clips/screenshots/branding) —
# a backstop in case the scheduled wipe interval is too long or a wipe fails.
DEMO_STORAGE_CAP_MB=300

# The one other origin allowed to call this API from a browser (CORS). Leave unset
# for same-origin only, which is the default in every mode. DEMO_ALLOWED_ORIGIN is
# still accepted as the older name.
ALLOWED_ORIGIN=

# ── Free studio (public, studio-only) ────────────────────────────────
# Set FREE_MODE to any truthy value to run a public studio-only instance:
# anyone can create a room and share its link; no shared passwords. Prep,
# editor, settings, plugins and the webhook are disabled, and recordings are
# never stored server-side (each participant keeps their own copy).
FREE_MODE=

# Max simultaneous rooms the instance will track.
FREE_MAX_ROOMS=200

# Max participants per room (WebRTC mesh — keep this small, 4-5 is the sweet spot).
FREE_MAX_PARTICIPANTS=5

# Minutes an empty room stays joinable before it expires.
FREE_ROOM_IDLE_MINUTES=120

# ── TURN relay (optional) ────────────────────────────────────────────
# STUN alone connects most peers directly; TURN relays media for networks that
# block direct paths (strict firewalls, some mobile carriers). Leave all of
# these unset for STUN only. Pick ONE provider:
#
# Cloudflare Realtime TURN — create a TURN key in the Cloudflare dashboard.
TURN_KEY_ID=
TURN_KEY_API_TOKEN=
#
# Self-hosted coturn (use-auth-secret): comma-separated URLs + the shared secret.
# e.g. TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:443?transport=tcp
TURN_URLS=
TURN_SECRET=
#
# How long issued credentials last, in seconds — must exceed your longest session.
TURN_TTL_SECONDS=43200

